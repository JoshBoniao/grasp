<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/buttonExitStudy"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_exit_study"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:backgroundTint="@android:color/transparent"
            style="@style/Widget.Material3.Button.TextButton" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textViewProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 1"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBarStudy"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/surface"
        android:layout_marginBottom="12dp"
        android:max="100"
        android:progress="0" />

    <!-- Swipe hint row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="← Wrong"
            android:textSize="13sp"
            android:textColor="@color/swipe_wrong"
            android:gravity="start" />

        <TextView
            android:id="@+id/textViewSwipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe to mark"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:visibility="gone" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Correct →"
            android:textSize="13sp"
            android:textColor="@color/swipe_correct"
            android:gravity="end" />

    </LinearLayout>

    <!-- Flashcard (swipeable + tappable) -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="32dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/textViewCardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_question_badge"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_hint"
            android:letterSpacing="0.15"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textViewCardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="21sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5" />

        <TextView
            android:id="@+id/textViewTapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_reveal"
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="24dp" />

    </LinearLayout>

    <!-- Nav buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/buttonPrev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_prev"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:backgroundTint="@color/surface"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/buttonFlip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="@string/btn_show_answer"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/buttonNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_next"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:backgroundTint="@color/surface" />

    </LinearLayout>

</LinearLayout>
